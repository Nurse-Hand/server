enum HandoffStatus {
  GENERATING
  DRAFT
  FINALIZED
}

enum HandoffItemSeverity {
  CRITICAL
  RECOMMENDED
}

enum HandoffAnswerCode {
  NO_ISSUE
  INCLUDE_HANDOFF
  UNVERIFIED
  NOT_APPLICABLE
}

enum HandoffEvidenceSourceType {
  TIMELINE_EVENT
  TASK
}

enum HandoffTaskPriority {
  CRITICAL
  HIGH
  NORMAL
}

enum HandoffClinicalSection {
  PATIENT_STATUS
  PAIN
  TREATMENT
  DIET
  ACTIVITY
  OBSERVATION
}

enum HandoffWarningType {
  UNVERIFIED
  UNANSWERED_RECOMMENDED
}

enum HandoffFinalizeResolution {
  RESOLVED
  KEEP_WITH_WARNING
}

enum HandoffAcknowledgementStatus {
  QUESTIONED
  ACKNOWLEDGED
}

enum HandoffAuditEventType {
  HANDOFF_CREATED
  GENERATION_RETRIED
  DRAFT_GENERATED
  DRAFT_UPDATED
  FINALIZED
  FIRST_VIEWED
  QUESTIONED
  ACKNOWLEDGED
}

model HandoffPrecheck {
  id                      String                         @id @default(uuid()) @db.Uuid
  datasetId               String                         @db.Uuid
  wardId                  String                         @db.Uuid
  senderActorId           String                         @db.Uuid
  receiverActorId         String                         @db.Uuid
  senderShiftId           String                         @db.Uuid
  receiverShiftId         String                         @db.Uuid
  handoffDate             DateTime                       @db.Date
  targetDuty              ShiftDuty
  aiJobId                 String                         @unique(map: "HandoffPrecheck_ai_job_id_key") @db.Uuid
  idempotencyRecordId     String                         @unique(map: "HandoffPrecheck_idempotency_record_id_key") @db.Uuid
  requestHash             String                         @db.Char(64)
  requestId               String                         @db.Uuid
  aiModelVersion          String?                        @db.VarChar(100)
  aiContractVersion       String?                        @db.VarChar(100)
  aiGeneratedAt           DateTime?                      @db.Timestamptz(3)
  version                 Int                            @default(1)
  lockedAt                DateTime?                      @db.Timestamptz(3)
  createdAt               DateTime                       @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime                       @updatedAt @db.Timestamptz(3)
  patientInputs           HandoffPrecheckPatientInput[]
  timelineInputs          HandoffPrecheckTimelineInput[]
  taskInputs              HandoffPrecheckTaskInput[]
  items                   HandoffPrecheckItem[]
  handoff                 Handoff?

  @@unique(name: "handoff_precheck_dataset_id", [datasetId, id])
  @@index([datasetId, wardId, senderActorId, createdAt(sort: Desc), id(sort: Desc)])
}

model HandoffPrecheckPatientInput {
  id         String          @id @default(uuid()) @db.Uuid
  datasetId  String          @db.Uuid
  precheckId String          @db.Uuid
  patientId  String          @db.Uuid
  position   Int
  version    Int             @default(1)
  createdAt  DateTime        @default(now()) @db.Timestamptz(3)
  precheck   HandoffPrecheck @relation(fields: [datasetId, precheckId], references: [datasetId, id], onDelete: Cascade)

  @@unique(name: "handoff_precheck_patient_dataset_id", [datasetId, id])
  @@unique(name: "handoff_precheck_patient_source", [datasetId, precheckId, patientId])
  @@unique(name: "handoff_precheck_patient_position", [datasetId, precheckId, position])
}

model HandoffPrecheckTimelineInput {
  id                    String                    @id @default(uuid()) @db.Uuid
  datasetId             String                    @db.Uuid
  precheckId            String                    @db.Uuid
  timelineEventId       String                    @db.Uuid
  patientId             String                    @db.Uuid
  occurredAt            DateTime                  @db.Timestamptz(3)
  eventType             TimelineEventType
  eventSource           TimelineEventSource
  sourceReference       String                    @db.VarChar(128)
  summary               String                    @db.VarChar(500)
  sourceVersion         Int
  version               Int                       @default(1)
  capturedAt            DateTime                  @db.Timestamptz(3)
  createdAt             DateTime                  @default(now()) @db.Timestamptz(3)
  precheck              HandoffPrecheck           @relation(fields: [datasetId, precheckId], references: [datasetId, id], onDelete: Cascade)
  precheckEvidence      HandoffPrecheckEvidence[]

  @@unique(name: "handoff_precheck_timeline_dataset_id", [datasetId, id])
  @@unique(name: "handoff_precheck_timeline_scope_id", [datasetId, precheckId, id])
  @@unique(name: "handoff_precheck_timeline_source", [datasetId, precheckId, timelineEventId])
  @@index([datasetId, precheckId, patientId, occurredAt(sort: Desc), timelineEventId(sort: Desc)])
}

model HandoffPrecheckTaskInput {
  id                    String                               @id @default(uuid()) @db.Uuid
  datasetId             String                               @db.Uuid
  precheckId            String                               @db.Uuid
  taskId                String                               @db.Uuid
  patientId             String?                              @db.Uuid
  title                 String                               @db.VarChar(500)
  dueAt                 DateTime?                            @db.Timestamptz(3)
  effectivePriority     HandoffTaskPriority
  sourceVersion         Int
  sourceUpdatedAt       DateTime                             @db.Timestamptz(3)
  version               Int                                  @default(1)
  capturedAt            DateTime                             @db.Timestamptz(3)
  createdAt             DateTime                             @default(now()) @db.Timestamptz(3)
  precheck              HandoffPrecheck                      @relation(fields: [datasetId, precheckId], references: [datasetId, id], onDelete: Cascade)
  sourceReferences      HandoffPrecheckTaskSourceReference[]
  precheckEvidence      HandoffPrecheckEvidence[]

  @@unique(name: "handoff_precheck_task_dataset_id", [datasetId, id])
  @@unique(name: "handoff_precheck_task_scope_id", [datasetId, precheckId, id])
  @@unique(name: "handoff_precheck_task_source", [datasetId, precheckId, taskId])
  @@index([datasetId, precheckId, patientId, dueAt, taskId])
}

model HandoffPrecheckTaskSourceReference {
  id          String                   @id @default(uuid()) @db.Uuid
  datasetId   String                   @db.Uuid
  precheckId  String                   @db.Uuid
  taskInputId String                   @db.Uuid
  reference   String                   @db.VarChar(128)
  version     Int                      @default(1)
  createdAt   DateTime                 @default(now()) @db.Timestamptz(3)
  taskInput   HandoffPrecheckTaskInput @relation(fields: [datasetId, precheckId, taskInputId], references: [datasetId, precheckId, id], onDelete: Cascade)

  @@unique(name: "handoff_precheck_task_reference_dataset_id", [datasetId, id])
  @@unique(name: "handoff_precheck_task_reference_value", [datasetId, precheckId, taskInputId, reference])
}

model HandoffPrecheckItem {
  id           String                     @id @default(uuid()) @db.Uuid
  datasetId    String                     @db.Uuid
  precheckId   String                     @db.Uuid
  position     Int
  severity     HandoffItemSeverity
  aiQuestion   String                     @db.Text
  aiReason     String                     @db.Text
  version      Int                        @default(1)
  createdAt    DateTime                   @default(now()) @db.Timestamptz(3)
  precheck     HandoffPrecheck            @relation(fields: [datasetId, precheckId], references: [datasetId, id], onDelete: Cascade)
  evidence     HandoffPrecheckEvidence[]
  answer       HandoffPrecheckAnswer?

  @@unique(name: "handoff_precheck_item_dataset_id", [datasetId, id])
  @@unique(name: "handoff_precheck_item_scope_id", [datasetId, precheckId, id])
  @@unique(name: "handoff_precheck_item_position", [datasetId, precheckId, position])
  @@index([datasetId, precheckId, severity, position, id])
}

model HandoffPrecheckEvidence {
  id              String                        @id @default(uuid()) @db.Uuid
  datasetId       String                        @db.Uuid
  precheckId      String                        @db.Uuid
  precheckItemId  String                        @db.Uuid
  sourceType      HandoffEvidenceSourceType
  timelineInputId String?                       @db.Uuid
  taskInputId     String?                       @db.Uuid
  version         Int                           @default(1)
  createdAt       DateTime                      @default(now()) @db.Timestamptz(3)
  item            HandoffPrecheckItem           @relation(fields: [datasetId, precheckId, precheckItemId], references: [datasetId, precheckId, id], onDelete: Cascade)
  timelineInput   HandoffPrecheckTimelineInput? @relation(fields: [datasetId, precheckId, timelineInputId], references: [datasetId, precheckId, id], onDelete: Restrict)
  taskInput       HandoffPrecheckTaskInput?     @relation(fields: [datasetId, precheckId, taskInputId], references: [datasetId, precheckId, id], onDelete: Restrict)

  @@unique(name: "handoff_precheck_evidence_dataset_id", [datasetId, id])
  @@unique(name: "handoff_precheck_evidence_timeline", [datasetId, precheckId, precheckItemId, timelineInputId], map: "HandoffPrecheckEvidence_timeline_key")
  @@unique(name: "handoff_precheck_evidence_task", [datasetId, precheckId, precheckItemId, taskInputId], map: "HandoffPrecheckEvidence_task_key")
  @@index([datasetId, precheckId, precheckItemId, sourceType, id])
}

model HandoffPrecheckAnswer {
  id                String              @id @default(uuid()) @db.Uuid
  datasetId         String              @db.Uuid
  precheckId        String              @db.Uuid
  precheckItemId    String              @db.Uuid
  answerCode        HandoffAnswerCode
  comment           String?             @db.Text
  answeredByActorId String              @db.Uuid
  answeredAt        DateTime            @db.Timestamptz(3)
  version           Int                 @default(1)
  createdAt         DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @db.Timestamptz(3)
  item              HandoffPrecheckItem @relation(fields: [datasetId, precheckId, precheckItemId], references: [datasetId, precheckId, id], onDelete: Cascade)

  @@unique(name: "handoff_precheck_answer_dataset_id", [datasetId, id])
  @@unique(name: "handoff_precheck_answer_item", [datasetId, precheckId, precheckItemId])
}

model Handoff {
  id                         String                          @id @default(uuid()) @db.Uuid
  datasetId                  String                          @db.Uuid
  wardId                     String                          @db.Uuid
  senderActorId              String                          @db.Uuid
  receiverActorId            String                          @db.Uuid
  senderShiftId              String                          @db.Uuid
  receiverShiftId            String                          @db.Uuid
  handoffDate                DateTime                        @db.Date
  targetDuty                 ShiftDuty
  status                     HandoffStatus                   @default(GENERATING)
  precheckId                 String                          @db.Uuid
  precheckVersion            Int
  templateKey                String                          @db.VarChar(64)
  includeUnverified          Boolean
  frozenInputPayload         Json
  frozenInputHash            String                          @db.Char(64)
  version                    Int                             @default(1)
  finalizedAt                DateTime?                       @db.Timestamptz(3)
  createdAt                  DateTime                        @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime                        @updatedAt @db.Timestamptz(3)
  precheck                   HandoffPrecheck                 @relation(fields: [datasetId, precheckId], references: [datasetId, id], onDelete: Restrict)
  generationAttempts         HandoffGenerationAttempt[]
  frozenPrecheckItems        HandoffFrozenPrecheckItem[]
  draftPatients              HandoffDraftPatient[]
  draftTasks                 HandoffDraftLinkedTask[]
  draftWarnings              HandoffDraftWarning[]
  finalSnapshot              HandoffFinalSnapshot?
  acknowledgements           HandoffAcknowledgement[]
  auditEvents                HandoffAuditEvent[]

  @@unique(name: "handoff_dataset_id", [datasetId, id])
  @@unique(name: "handoff_dataset_scope_id", [datasetId, wardId, id])
  @@unique(name: "handoff_precheck", [datasetId, precheckId])
  @@index([datasetId, wardId, senderActorId, handoffDate, status, updatedAt(sort: Desc), id(sort: Desc)])
  @@index([datasetId, wardId, receiverActorId, handoffDate, status, updatedAt(sort: Desc), id(sort: Desc)])
}

model HandoffGenerationAttempt {
  id                  String   @id @default(uuid()) @db.Uuid
  datasetId           String   @db.Uuid
  handoffId           String   @db.Uuid
  aiJobId             String   @unique(map: "HandoffGenerationAttempt_ai_job_id_key") @db.Uuid
  idempotencyRecordId String   @unique(map: "HandoffGenerationAttempt_idempotency_record_id_key") @db.Uuid
  requestHash         String   @db.Char(64)
  requestId           String   @db.Uuid
  sequence            Int
  aiModelVersion      String?  @db.VarChar(100)
  aiContractVersion   String?  @db.VarChar(100)
  aiGeneratedAt       DateTime? @db.Timestamptz(3)
  publishedAt         DateTime? @db.Timestamptz(3)
  version             Int      @default(1)
  createdAt           DateTime @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @db.Timestamptz(3)
  handoff             Handoff  @relation(fields: [datasetId, handoffId], references: [datasetId, id], onDelete: Cascade)

  @@unique(name: "handoff_generation_attempt_dataset_id", [datasetId, id])
  @@unique(name: "handoff_generation_attempt_sequence", [datasetId, handoffId, sequence])
  @@index([datasetId, handoffId, sequence(sort: Desc), id(sort: Desc)])
}

model HandoffFrozenPrecheckItem {
  id                  String                           @id @default(uuid()) @db.Uuid
  datasetId           String                           @db.Uuid
  handoffId           String                           @db.Uuid
  sourcePrecheckItemId String                           @db.Uuid
  position            Int
  severity            HandoffItemSeverity
  aiQuestion          String                           @db.Text
  answerCode          HandoffAnswerCode?
  answerComment       String?                          @db.Text
  answeredByActorId   String?                          @db.Uuid
  answeredAt          DateTime?                        @db.Timestamptz(3)
  sourceItemVersion   Int
  sourceAnswerVersion Int?
  isWarningCandidate  Boolean
  version             Int                              @default(1)
  createdAt           DateTime                         @default(now()) @db.Timestamptz(3)
  handoff             Handoff                          @relation(fields: [datasetId, handoffId], references: [datasetId, id], onDelete: Cascade)
  evidence            HandoffFrozenPrecheckEvidence[]

  @@unique(name: "handoff_frozen_item_dataset_id", [datasetId, id])
  @@unique(name: "handoff_frozen_item_scope_id", [datasetId, handoffId, id])
  @@unique(name: "handoff_frozen_item_source", [datasetId, handoffId, sourcePrecheckItemId])
  @@unique(name: "handoff_frozen_item_position", [datasetId, handoffId, position])
  @@index([datasetId, handoffId, severity, position, id])
}

model HandoffFrozenPrecheckEvidence {
  id           String                      @id @default(uuid()) @db.Uuid
  datasetId    String                      @db.Uuid
  handoffId    String                      @db.Uuid
  frozenItemId String                      @db.Uuid
  sourceType   HandoffEvidenceSourceType
  sourceId     String                      @db.Uuid
  version      Int                         @default(1)
  createdAt    DateTime                    @default(now()) @db.Timestamptz(3)
  frozenItem   HandoffFrozenPrecheckItem   @relation(fields: [datasetId, handoffId, frozenItemId], references: [datasetId, handoffId, id], onDelete: Cascade)

  @@unique(name: "handoff_frozen_evidence_dataset_id", [datasetId, id])
  @@unique(name: "handoff_frozen_evidence_source", [datasetId, handoffId, frozenItemId, sourceType, sourceId])
  @@index([datasetId, handoffId, frozenItemId, id])
}

model HandoffDraftPatient {
  id         String                @id @default(uuid()) @db.Uuid
  datasetId  String                @db.Uuid
  handoffId  String                @db.Uuid
  patientId  String                @db.Uuid
  position   Int
  version    Int                   @default(1)
  createdAt  DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime              @updatedAt @db.Timestamptz(3)
  handoff    Handoff               @relation(fields: [datasetId, handoffId], references: [datasetId, id], onDelete: Cascade)
  sections   HandoffDraftSection[]

  @@unique(name: "handoff_draft_patient_dataset_id", [datasetId, id])
  @@unique(name: "handoff_draft_patient_scope_id", [datasetId, handoffId, id])
  @@unique(name: "handoff_draft_patient", [datasetId, handoffId, patientId])
  @@unique(name: "handoff_draft_patient_position", [datasetId, handoffId, position])
}

model HandoffDraftSection {
  id             String                   @id @default(uuid()) @db.Uuid
  datasetId      String                   @db.Uuid
  handoffId      String                   @db.Uuid
  draftPatientId String                   @db.Uuid
  section        HandoffClinicalSection
  aiOriginalText String                   @db.Text
  currentText    String                   @db.Text
  isModified     Boolean                  @default(false)
  version        Int                      @default(1)
  createdAt      DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime                 @updatedAt @db.Timestamptz(3)
  draftPatient   HandoffDraftPatient      @relation(fields: [datasetId, handoffId, draftPatientId], references: [datasetId, handoffId, id], onDelete: Cascade)
  citations      HandoffDraftCitation[]

  @@unique(name: "handoff_draft_section_dataset_id", [datasetId, id])
  @@unique(name: "handoff_draft_section_scope_id", [datasetId, handoffId, draftPatientId, id])
  @@unique(name: "handoff_draft_section", [datasetId, handoffId, draftPatientId, section])
  @@index([datasetId, handoffId, draftPatientId, section, id])
}

model HandoffDraftCitation {
  id             String                    @id @default(uuid()) @db.Uuid
  datasetId      String                    @db.Uuid
  handoffId      String                    @db.Uuid
  draftPatientId String                    @db.Uuid
  draftSectionId String                    @db.Uuid
  sourceType     HandoffEvidenceSourceType
  sourceId       String                    @db.Uuid
  position       Int
  version        Int                       @default(1)
  createdAt      DateTime                  @default(now()) @db.Timestamptz(3)
  draftSection   HandoffDraftSection       @relation(fields: [datasetId, handoffId, draftPatientId, draftSectionId], references: [datasetId, handoffId, draftPatientId, id], onDelete: Cascade)

  @@unique(name: "handoff_draft_citation_dataset_id", [datasetId, id])
  @@unique(name: "handoff_draft_citation_source", [datasetId, handoffId, draftSectionId, sourceType, sourceId])
  @@unique(name: "handoff_draft_citation_position", [datasetId, handoffId, draftSectionId, position])
  @@index([datasetId, handoffId, draftPatientId, draftSectionId, position, id])
}

model HandoffDraftLinkedTask {
  id                    String               @id @default(uuid()) @db.Uuid
  datasetId             String               @db.Uuid
  handoffId             String               @db.Uuid
  taskId                String               @db.Uuid
  patientId             String?              @db.Uuid
  title                 String               @db.VarChar(500)
  dueAt                 DateTime?            @db.Timestamptz(3)
  effectivePriority     HandoffTaskPriority
  sourceVersion         Int
  sourceUpdatedAt       DateTime             @db.Timestamptz(3)
  linkedByActorId       String               @db.Uuid
  position              Int
  version               Int                  @default(1)
  createdAt             DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime             @updatedAt @db.Timestamptz(3)
  handoff               Handoff              @relation(fields: [datasetId, handoffId], references: [datasetId, id], onDelete: Cascade)
  sourceReferences      HandoffDraftTaskSourceReference[]

  @@unique(name: "handoff_draft_task_dataset_id", [datasetId, id])
  @@unique(name: "handoff_draft_task_scope_id", [datasetId, handoffId, id])
  @@unique(name: "handoff_draft_task", [datasetId, handoffId, taskId])
  @@unique(name: "handoff_draft_task_position", [datasetId, handoffId, position])
  @@index([datasetId, handoffId, patientId, position, id])
}

model HandoffDraftTaskSourceReference {
  id            String                 @id @default(uuid()) @db.Uuid
  datasetId     String                 @db.Uuid
  handoffId     String                 @db.Uuid
  linkedTaskId  String                 @db.Uuid
  reference     String                 @db.VarChar(128)
  version       Int                    @default(1)
  createdAt     DateTime               @default(now()) @db.Timestamptz(3)
  linkedTask    HandoffDraftLinkedTask @relation(fields: [datasetId, handoffId, linkedTaskId], references: [datasetId, handoffId, id], onDelete: Cascade)

  @@unique(name: "handoff_draft_task_reference_dataset_id", [datasetId, id])
  @@unique(name: "handoff_draft_task_reference", [datasetId, handoffId, linkedTaskId, reference])
}

model HandoffDraftWarning {
  id                 String             @id @default(uuid()) @db.Uuid
  datasetId          String             @db.Uuid
  handoffId          String             @db.Uuid
  precheckItemId     String?            @db.Uuid
  warningType        HandoffWarningType
  message            String             @db.Text
  isIncludedInAiInput Boolean
  version            Int                @default(1)
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @db.Timestamptz(3)
  handoff            Handoff            @relation(fields: [datasetId, handoffId], references: [datasetId, id], onDelete: Cascade)

  @@unique(name: "handoff_draft_warning_dataset_id", [datasetId, id])
  @@unique(name: "handoff_draft_warning_item", [datasetId, handoffId, warningType, precheckItemId])
  @@index([datasetId, handoffId, warningType, createdAt, id])
}

model HandoffFinalSnapshot {
  id                    String                     @id @default(uuid()) @db.Uuid
  datasetId             String                     @db.Uuid
  wardId                String                     @db.Uuid
  handoffId             String                     @db.Uuid
  senderActorId         String                     @db.Uuid
  receiverActorId       String                     @db.Uuid
  finalizedByActorId    String                     @db.Uuid
  resolution            HandoffFinalizeResolution
  sourceDraftVersion    Int
  precheckVersion       Int
  templateKey           String                     @db.VarChar(64)
  includeUnverified     Boolean
  idempotencyRecordId   String                     @unique(map: "HandoffFinalSnapshot_idempotency_record_id_key") @db.Uuid
  requestHash           String                     @db.Char(64)
  snapshotPayload       Json
  snapshotHash          String                     @db.Char(64)
  version               Int                        @default(1)
  finalizedAt           DateTime                   @db.Timestamptz(3)
  createdAt             DateTime                   @default(now()) @db.Timestamptz(3)
  handoff               Handoff                    @relation(fields: [datasetId, handoffId], references: [datasetId, id], onDelete: Restrict)

  @@unique(name: "handoff_final_snapshot_dataset_id", [datasetId, id])
  @@unique(name: "handoff_final_snapshot_handoff", [datasetId, handoffId])
  @@index([datasetId, wardId, senderActorId, finalizedAt(sort: Desc), id(sort: Desc)])
  @@index([datasetId, wardId, receiverActorId, finalizedAt(sort: Desc), id(sort: Desc)])
}

model HandoffAcknowledgement {
  id                  String                          @id @default(uuid()) @db.Uuid
  datasetId           String                          @db.Uuid
  wardId              String                          @db.Uuid
  handoffId           String                          @db.Uuid
  senderActorId       String                          @db.Uuid
  receiverActorId     String                          @db.Uuid
  status              HandoffAcknowledgementStatus
  comment             String?                         @db.Text
  idempotencyRecordId String                          @unique(map: "HandoffAcknowledgement_idempotency_record_id_key") @db.Uuid
  requestHash         String                          @db.Char(64)
  version             Int                             @default(1)
  createdAt           DateTime                        @default(now()) @db.Timestamptz(3)
  handoff             Handoff                         @relation(fields: [datasetId, handoffId], references: [datasetId, id], onDelete: Restrict)
  auditEvent          HandoffAuditEvent?

  @@unique(name: "handoff_acknowledgement_dataset_id", [datasetId, id])
  @@unique(name: "handoff_acknowledgement_scope_id", [datasetId, handoffId, id])
  @@unique(name: "handoff_acknowledgement_status", [datasetId, handoffId, status])
  @@index([datasetId, handoffId, status, createdAt(sort: Desc), id(sort: Desc)])
  @@index([datasetId, wardId, receiverActorId, createdAt(sort: Desc), id(sort: Desc)])
}

model HandoffAuditEvent {
  id                    String                      @id @default(uuid()) @db.Uuid
  datasetId             String                      @db.Uuid
  wardId                String                      @db.Uuid
  handoffId             String                      @db.Uuid
  senderActorId         String                      @db.Uuid
  receiverActorId       String                      @db.Uuid
  actorId               String                      @db.Uuid
  eventType             HandoffAuditEventType
  acknowledgementId     String?                     @db.Uuid
  deduplicationKey      String?                     @db.VarChar(255)
  eventPayload          Json?
  version               Int                         @default(1)
  occurredAt            DateTime                    @db.Timestamptz(3)
  createdAt             DateTime                    @default(now()) @db.Timestamptz(3)
  handoff               Handoff                     @relation(fields: [datasetId, handoffId], references: [datasetId, id], onDelete: Restrict)
  acknowledgement       HandoffAcknowledgement?     @relation(fields: [datasetId, handoffId, acknowledgementId], references: [datasetId, handoffId, id], onDelete: Restrict)

  @@unique(name: "handoff_audit_event_dataset_id", [datasetId, id])
  @@unique(name: "handoff_audit_event_acknowledgement", [datasetId, handoffId, acknowledgementId])
  @@unique(name: "handoff_audit_event_deduplication", [datasetId, handoffId, deduplicationKey])
  @@index([datasetId, handoffId, occurredAt, id])
  @@index([datasetId, wardId, actorId, occurredAt(sort: Desc), id(sort: Desc)])
}
