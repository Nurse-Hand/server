  "info": {
    "title": "Nurse Hand Public API",
    "description": "Nurse Hand 모바일 앱을 위한 공개 Node.js API",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "demo-session": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Demo-Session-Id",
        "description": "인증 제외 기간에 보호 API의 dataset/actor/ward 범위를 복원하는 opaque demo session 값"
      }
    },
    "schemas": {
      "CreateDemoSessionRequestDto": {
        "type": "object",
        "properties": {
          "scenarioKey": {
            "type": "string",
            "enum": [
              "SYNTHETIC_MEDICAL_DAY_SHIFT"
            ]
          }
        },
        "required": [
          "scenarioKey"
        ]
      },
      "DemoSessionCredentialDto": {
        "type": "object",
        "properties": {
          "persona": {
            "enum": [
              "SENDER",
              "RECEIVER"
            ],
            "type": "string"
          },
          "sessionId": {
            "type": "string",
            "description": "X-Demo-Session-Id header로 전달할 1회 발급 opaque session 값",
            "example": "syntheticOpaqueSessionValueNotPersistedAsPlaintext"
          }
        },
        "required": [
          "persona",
          "sessionId"
        ]
      },
      "DemoSessionDataDto": {
        "type": "object",
        "properties": {
          "scenarioKey": {
            "type": "string",
            "enum": [
              "SYNTHETIC_MEDICAL_DAY_SHIFT"
            ]
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-08-18T01:00:00.000Z"
          },
          "sessions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DemoSessionCredentialDto"
            }
          }
        },
        "required": [
          "scenarioKey",
          "expiresAt",
          "sessions"
        ]
      },
      "ApiMetaDto": {
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "requestId"
        ]
      },
      "DemoSessionResponseDto": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/DemoSessionDataDto"
          },
          "meta": {
            "$ref": "#/components/schemas/ApiMetaDto"
          }
        },
        "required": [
          "data",
          "meta"
        ]
      },
      "ApiErrorDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "VALIDATION_FAILED"
          },
          "message": {
            "type": "string",
            "example": "요청 값이 올바르지 않습니다."
          },
          "details": {
            "type": "object",
            "description": "클라이언트가 수정 가능한 구조화 오류 정보"
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "ApiErrorResponseDto": {
        "type": "object",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ApiErrorDto"
          },
          "meta": {
            "$ref": "#/components/schemas/ApiMetaDto"
          }
        },
        "required": [
          "error",
          "meta"
        ]
      },
      "UploadFileRequestDto": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string",
