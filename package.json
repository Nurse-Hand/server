{
  "name": "nurse-hand-server",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=24.17.0 <25",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "build": "nest build",
    "prebuild": "npm run prisma:generate",
    "format": "prettier --write \"{src,test,scripts}/**/*.ts\" \"prisma.config.ts\" \"*.{json,mjs,cjs}\" \"test/**/*.cjs\" \".github/**/*.{yml,yaml}\"",
    "format:check": "prettier --check \"{src,test,scripts}/**/*.ts\" \"prisma.config.ts\" \"*.{json,mjs,cjs}\" \"test/**/*.cjs\" \".github/**/*.{yml,yaml}\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/src/main.js",
    "lint": "eslint \"{src,test,scripts}/**/*.ts\" \"prisma.config.ts\"",
    "lint:fix": "npm run lint -- --fix",
    "typecheck": "tsc --noEmit",
    "pretypecheck": "npm run prisma:generate",
    "test": "jest --runInBand",
    "pretest": "npm run prisma:generate",
    "test:e2e": "jest --config test/jest-e2e.config.cjs --runInBand",
    "pretest:e2e": "npm run prisma:generate",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "openapi:generate": "npm run build && node dist/scripts/generate-openapi.js",
    "openapi:check": "npm run build && npm run openapi:check:built",
    "openapi:check:built": "node dist/scripts/check-openapi.js",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run test:e2e && npm run prisma:validate && npm run build && npm run openapi:check:built"
  },
  "dependencies": {
    "@nestjs/common": "11.2.1",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.1",
    "@nestjs/platform-express": "11.2.1",
    "@nestjs/swagger": "11.4.7",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "17.4.2",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.1",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.11.0",
    "jest": "30.4.2",
    "prettier": "3.9.6",
    "prisma": "7.9.1",
    "supertest": "7.2.2",
    "ts-jest": "29.4.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0"
  }
}
